{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": [
    "AGENTS.md",
    "docs/conventions.md",
    "docs/architecture.md",
    "docs/data_model.md"
  ],
  "formatter": true,
  "lsp": false,
  "permission": {
    "custom_context_*": "allow",
    "project_memory_*": "allow",
    "lint_*": "allow",
    "brain_turn": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow"
    },
    "shell": {
      "git add": "deny",
      "git add *": "deny",
      "git checkout": "deny",
      "git checkout *": "deny",
      "git commit": "deny",
      "git commit *": "deny",
      "git push": "deny",
      "git push *": "deny"
    }
  }
}
